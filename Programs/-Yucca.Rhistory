plot(predict)
Micro_figure <- predict %>%
filter(!(facet == "F" & group == "Selfed") & !(facet == "F" & group == "No Pollen"))
(fruit_plot2 <- ggplot(data = Micro_figure,
aes(x = x, y = predicted, color = group, fill = group)) +
geom_line(size = 1) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(x = "Number of Surrounding Hermaphrodites", y = "Fruit Production") +
theme_classic()+
scale_fill_manual(values = c("black", "#00008B", "#9ACD32", "#EEC900")) +
scale_color_manual(values = c("black", "#00008B", "#9ACD32", "#EEC900"))+
theme(legend.title = element_blank()))
(fruit_microSR <- ggplot(data = Micro_figure,
aes(x = x, y = predicted, color = facet, fill = facet)) +
geom_line(size = 1) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = 0.2) +
labs(x = "Number of Surrounding Hermaphrodites", y = "Fruit Set\n Proportion") +
theme_classic()+
scale_fill_manual(values = c("#7A378B", "#66CD00")) +
scale_color_manual(values = c("#7A378B", "#66CD00"))+
facet_wrap(~group)+
theme(legend.title = element_blank()))
